# SkillAd Mobile App — Production Environment Variables
# For local Metro against production API, copy needed keys to .env (gitignored).
#
# EAS Build:
# - Non-secret public vars are set in eas.json (API URL, PROJECT_ID, APP_ENV).
# - Supabase MUST be EAS Secrets (never commit real values):
#     eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "https://xxxx.supabase.co"
#     eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "eyJ..."
#   Do not put real Supabase credentials in this file or eas.json.

# API Server (also set in eas.json)
EXPO_PUBLIC_API_URL=https://api.skillad.in/api

# Supabase — placeholders only. Real values = EAS Secrets / local .env
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Must match app.json → extra.eas.projectId and eas.json
EXPO_PUBLIC_PROJECT_ID=12a62e59-2beb-4271-8a4d-f40acd8af870

EXPO_PUBLIC_APP_ENV=production
