PORT=3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co/rest/v1/
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SESSION_SECRET=generate-a-random-32-char-string-here
ADMIN_KEY=change-this-in-production
# MSG91 SMS OTP — MSG91_TEMPLATE_ID must be the DLT-verified SkillAd_Login_OTP template ID
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
# MSG91 transactional SMS (Flow API) — separate from OTP template above
MSG91_TEMPLATE_SUBSCRIPTION_ACTIVATED=
MSG91_TEMPLATE_SUBSCRIPTION_REMINDER=
MSG91_TEMPLATE_PAYMENT_SUCCESS=
# Demo OTP 123456 — must be explicitly true. Leave unset or false in production.
OTP_TEST_MODE=true
NODE_ENV=development

# Google Play reviewer login (Hostinger env only). Slot is inactive until phone, 6-digit CODE, and USER_ID are all set.
# CODE must not be 123456. Never put codes in the mobile app or commit them.
# Designated numbers: Test Customer 1234567891, Test Provider 9876543210
PLAY_REVIEWER_CUSTOMER_PHONE=1234567891
PLAY_REVIEWER_CUSTOMER_CODE=
PLAY_REVIEWER_CUSTOMER_USER_ID=
PLAY_REVIEWER_PROVIDER_PHONE=9876543210
PLAY_REVIEWER_PROVIDER_CODE=
PLAY_REVIEWER_PROVIDER_USER_ID=

# Mail (SMTP) — used by Contact form notifications via mailService
# Leave blank to skip sending (messages still saved to Supabase)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SkillAd <noreply@skillad.in>
